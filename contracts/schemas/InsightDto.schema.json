{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InsightDto",
  "$ref": "#/$defs/InsightDto",
  "$defs": {
    "BankViewDto": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/BankViewStatus"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "claim_ids"
      ],
      "additionalProperties": false
    },
    "BankViewStatus": {
      "type": "string",
      "enum": [
        "found",
        "not_found"
      ]
    },
    "ClaimDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification_status": {
          "$ref": "#/$defs/ClaimVerification"
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "text",
        "origin",
        "refs",
        "verification_status",
        "confidence"
      ],
      "additionalProperties": false
    },
    "ClaimVerification": {
      "type": "string",
      "enum": [
        "code_passed",
        "critic_passed",
        "not_confirmed"
      ]
    },
    "CodeStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "Confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "ConsequenceDto": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/ConsequenceType"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "type",
        "claim_ids"
      ],
      "additionalProperties": false
    },
    "ConsequenceType": {
      "type": "string",
      "enum": [
        "risk",
        "opportunity",
        "neutral"
      ]
    },
    "CriticStatus": {
      "type": "string",
      "enum": [
        "passed",
        "issues_found",
        "skipped_disabled",
        "skipped_budget",
        "skipped_error"
      ]
    },
    "CriticVerificationDto": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/CriticStatus"
        },
        "request_count": {
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "request_count",
        "reason"
      ],
      "additionalProperties": false
    },
    "EvidenceDto": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "source": {
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        },
        "dataset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "approximate": {
          "type": "boolean"
        },
        "chart_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "page_image_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "source",
        "url",
        "quote",
        "date",
        "document_id",
        "page",
        "chunk_id",
        "key",
        "value",
        "dataset",
        "review_status",
        "approximate",
        "chart_id",
        "page_image_url"
      ],
      "additionalProperties": false
    },
    "EvidenceType": {
      "type": "string",
      "enum": [
        "news",
        "bank_research",
        "company_feature",
        "payment_aggregate",
        "group_feature"
      ]
    },
    "FeatureContribution": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/RankingFeatureCode"
        },
        "value": {
          "type": "number"
        },
        "weight": {
          "type": "number"
        },
        "contribution": {
          "type": "number"
        },
        "known": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "value",
        "weight",
        "contribution",
        "known",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "ForecastDto": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/ForecastStatus"
        },
        "metric": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ForecastInputDto"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      },
      "required": [
        "status",
        "metric",
        "unit",
        "low",
        "high",
        "formula",
        "inputs",
        "assumptions",
        "missing_data",
        "origin"
      ],
      "additionalProperties": false
    },
    "ForecastInputDto": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "assumed": {
          "type": "boolean"
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "assumed",
        "refs"
      ],
      "additionalProperties": false
    },
    "ForecastStatus": {
      "type": "string",
      "enum": [
        "estimated",
        "insufficient_data"
      ]
    },
    "InsightDto": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "company_id": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "headline": {
          "type": "string"
        },
        "relevance": {
          "$ref": "#/$defs/RelevanceDto"
        },
        "what_happened": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why_it_matters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consequences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConsequenceDto"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bank_view": {
          "$ref": "#/$defs/BankViewDto"
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClaimDto"
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EvidenceDto"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "suggested_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trace_id": {
          "type": "string"
        },
        "verification": {
          "$ref": "#/$defs/VerificationDto"
        },
        "forecast": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForecastDto"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "event_id",
        "company_id",
        "role",
        "as_of",
        "headline",
        "relevance",
        "what_happened",
        "why_it_matters",
        "consequences",
        "actions",
        "bank_view",
        "claims",
        "evidence",
        "limitations",
        "suggested_questions",
        "trace_id",
        "verification"
      ],
      "additionalProperties": false
    },
    "Origin": {
      "type": "string",
      "enum": [
        "source_fact",
        "bank_analytics",
        "ai_inference",
        "ai_hypothesis"
      ]
    },
    "RankingFeatureCode": {
      "type": "string",
      "enum": [
        "okved",
        "factor",
        "product",
        "country",
        "cp",
        "group"
      ]
    },
    "RelevanceDto": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number"
        },
        "rank": {
          "type": "integer"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RelevanceReasonDto"
          }
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FeatureContribution"
          }
        }
      },
      "required": [
        "score",
        "rank",
        "reasons",
        "contributions"
      ],
      "additionalProperties": false
    },
    "RelevanceReasonDto": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "text",
        "claim_ids",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "ReviewStatus": {
      "type": "string",
      "enum": [
        "not_reviewed",
        "partially_reviewed",
        "reviewed"
      ]
    },
    "Role": {
      "type": "string",
      "enum": [
        "ceo",
        "cfo"
      ]
    },
    "VerificationDto": {
      "type": "object",
      "properties": {
        "code_status": {
          "$ref": "#/$defs/CodeStatus"
        },
        "critic": {
          "$ref": "#/$defs/CriticVerificationDto"
        },
        "repair_count": {
          "type": "integer"
        }
      },
      "required": [
        "code_status",
        "critic",
        "repair_count"
      ],
      "additionalProperties": false
    }
  }
}