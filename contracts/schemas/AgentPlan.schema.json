{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentPlan",
  "$ref": "#/$defs/AgentPlan",
  "$defs": {
    "AgentPlan": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolCall"
          }
        },
        "questions_to_resolve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "calls",
        "questions_to_resolve"
      ],
      "additionalProperties": false
    },
    "ToolCall": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "arguments": {}
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    }
  }
}