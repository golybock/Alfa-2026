# Copy to .env in the repository root; never commit the populated .env.
APP_ENVIRONMENT=Development
HTTP_PORT=8080
POSTGRES_DB=alfanews
POSTGRES_USER=alfanews
POSTGRES_PASSWORD=replace-with-a-local-password
LLM_BASE_URL=https://replace-with-provider.example/v1
LLM_API_KEY=replace-with-provider-key
# Use exact IDs from your provider, not these placeholders.
DEEPSEEK_MODEL_ID=replace-with-deepseek-v4.1-flash-provider-id
GLM_MODEL_ID=replace-with-glm-5.3-flash-provider-id