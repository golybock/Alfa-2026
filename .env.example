# Основное. Остальное имеет значения по умолчанию в compose.yaml и коде — см. блок «Тонкая настройка» ниже.
HTTP_PORT=8080
# Внешний адрес сайта за шлюзом; с него API принимает изменяющие запросы (Origin). Пусто — http://localhost:HTTP_PORT.
PUBLIC_ORIGIN=
POSTGRES_DB=alfanews
POSTGRES_USER=alfanews
POSTGRES_PASSWORD=replace-with-a-local-password
# true — модель не вызывается (MockLlm), ключ не нужен. Для живой модели: false и адрес шлюза с ключом.
LLM_USE_MOCK=true
LLM_BASE_URL=
LLM_API_KEY=
# Компании ленты; для каждой Worker создаёт учётку с логином = id компании (пароль password, см. README).
FEED_COMPANY_IDS=U_68157,U_71942,U_258515
# Дневной лимит расходов этого стенда на модель, ₽ (сутки с 03:00 МСК). Задания сверх лимита завершаются budget_exhausted и повторяются вручную.
# Ключ модели общий на команду: Worker дополнительно сверяется с расходом и лимитом ключа на шлюзе (/key/info).
LLM_DAILY_LIMIT_RUB=500

# Тонкая настройка. Ниже значения по умолчанию; раскомментируйте строку, только если нужно другое значение.
# Модель на каждое использование, полным именем шлюза. Разрешены: deepseek/deepseek-v4.1-flash, z-ai/glm-5.3-flash,
# google/gemma-4-26b-a4b-it, qwen/qwen3.6-35b-a3b, qwen/qwen3-vl-30b-a3b-instruct, moonshotai/kimi-k2.6; другое Worker не запустит.
# Фильтр заголовков новостей:
# LLM_TRIAGE_MODEL=deepseek/deepseek-v4.1-flash
# Разбор новости в факты:
# LLM_EXTRACT_MODEL=deepseek/deepseek-v4.1-flash
# Агент карточки: план и черновик:
# LLM_AGENT_MODEL=deepseek/deepseek-v4.1-flash
# Починка ответов (кроме фильтра и разбора — они чинятся своей моделью):
# LLM_REPAIR_MODEL=deepseek/deepseek-v4.1-flash
# Критик карточки:
# LLM_CRITIC_MODEL=z-ai/glm-5.3-flash
# Распознавание PDF (нужна модель, принимающая изображения):
# LLM_OCR_MODEL=z-ai/glm-5.3-flash
# Ответы чата по карточке и проверка, что вопрос по теме:
# LLM_CHAT_MODEL=deepseek/deepseek-v4.1-flash
# LLM_SCOPE_GATE_MODEL=deepseek/deepseek-v4.1-flash
# Рассуждения: включены у всех задач, кроме фильтра заголовков; у GLM-5.3-Flash они принудительные.
# LLM_THINKING_ENABLED=true
# LLM_EXTRACT_THINKING_ENABLED=true
# LLM_GLM_REASONING_LEVEL=low
# LLM_STRUCTURED_OUTPUT=true
# CRITIC_ENABLED=true
# CRITIC_SCOPE=all_full
# Лента: live — живая лента; demo — снимок, заранее посчитанный командой Worker precompute-demo.
# FEED_MODE=live
# FEED_REFRESH_INTERVAL_SECONDS=86400
# RANKING_MIN_BASE=0.30
# RANKING_MIN_SCORE=0.15
# Параллельность Worker: исполнители полос (1–16) и общий предел одновременных запросов к модели (1–16).
# Полоса data всегда последовательная. Карточки CEO и CFO одного события не идут одновременно: вторая ждёт общий план.
# QUEUE_NEWS_SLOTS=4
# QUEUE_DOCUMENTS_SLOTS=3
# QUEUE_INSIGHTS_SLOTS=2
# QUEUE_CHAT_SLOTS=2
# LLM_MAX_PARALLEL_REQUESTS=8
# Оценка цены для резерва бюджета до ответа модели, ₽ за 1 млн токенов.
# LLM_DEEPSEEK_INPUT_ESTIMATE_RUB_PER_MILLION=55
# LLM_DEEPSEEK_OUTPUT_ESTIMATE_RUB_PER_MILLION=100
# LLM_GLM_INPUT_ESTIMATE_RUB_PER_MILLION=22
# LLM_GLM_OUTPUT_ESTIMATE_RUB_PER_MILLION=50
# Запуск API и Worker без Docker (dotnet run): адреса PostgreSQL и сервиса векторов на хосте.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=15432
# Embeddings__BaseUrl=http://127.0.0.1:18081