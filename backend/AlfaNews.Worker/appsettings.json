{
  "Storage": {
    "RootPath": "data/cache/research",
    "PdfInfoPath": "pdfinfo",
    "PdfToPpmPath": "pdftoppm",
    "ProcessTimeoutSeconds": 120
  },
  "Data": {
    "ImportOnStartup": false,
    "InputPath": "data",
    "DatasetVersion": "hackathon-2026-v1",
    "ImportReportPath": "data/reports/import_report.json",
    "BuildProfilesOnStartup": false,
    "ProfilesReportPath": "data/reports/profile_candidates.json"
  },
  "Embeddings": {
    "BaseUrl": "http://127.0.0.1:18081"
  },
  "Feed": {
    "CompanyIds": "",
    "RefreshIntervalSeconds": 86400
  },
  "TestJob": {
    "Enabled": false,
    "Text": "Очередь Worker работает."
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Llm": {
    "UseMock": true,
    "DeepSeekModel": "deepseek/deepseek-v4.1-flash",
    "GlmModel": "z-ai/glm-5.3-flash",
    "DeepSeekReasoningLevel": "medium",
    "GlmReasoningLevel": "low",
    "DeepSeekThinkingEnabled": true,
    "StructuredOutput": true,
    "MaxOutputTokens": 32000,
    "ChatMaxOutputTokens": 8000,
    "TimeoutSeconds": 240,
    "CriticTimeoutSeconds": 120,
    "DailyLimitRub": 500,
    "DeepSeekInputEstimateRubPerMillion": 55,
    "DeepSeekOutputEstimateRubPerMillion": 100,
    "GlmInputEstimateRubPerMillion": 22,
    "GlmOutputEstimateRubPerMillion": 50,
    "CriticEnabled": true,
    "CriticScope": "all_full",
    "ConfigVersion": "llm-v1"
  }
}