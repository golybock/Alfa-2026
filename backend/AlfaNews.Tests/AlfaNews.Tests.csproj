<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AlfaNews.Core\AlfaNews.Core.csproj" />
      <ProjectReference Include="..\AlfaNews.Api\AlfaNews.Api.csproj" />
      <ProjectReference Include="..\AlfaNews.Worker\AlfaNews.Worker.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\contracts\examples\*.json" Link="Examples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="Fixtures\ingest\*" Link="Fixtures\ingest\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\contracts\database.sql" Link="database.sql" CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\..\data\taxonomy.json" Link="taxonomy.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>